clc
clear all

a = [3 -1 2; -2 4 0; -4 3 8];
b = [7;12;10];
c = [1 -3 2];

n = size(a,2);
s = eye(size(a,1));
A = [a s b];

cost = zeros(1,size(A,2));
cost(1:n) = c;

bv = n+1 : size(A,2)-1;

zjcj = cost(bv)*A - cost;
zcj = [zjcj; A];

simptable = array2table(zcj);
simptable.Properties.VariableNames = {'x1','x2','x3','s1','s2','s3','sol'};
disp('Initial Table:')
disp(simptable)

run = true;

while run
    
    zc = zjcj(1:end-1);
    
    % MIN condition
    if any(zc > 0)
        
        % Pivot column
        [~, pvt_col] = max(zc);
        
        % Ratio
        sol = A(:,end);
        col = A(:,pvt_col);
        
        ratio = inf(size(A,1),1);  
        
        for i=1:size(A,1)
            if col(i) > 0
                ratio(i) = sol(i)/col(i);
            end
        end
        
        [~, pvt_row] = min(ratio);
        
        % Pivot
        pvt_key = A(pvt_row,pvt_col);
        bv(pvt_row) = pvt_col;
        
        A(pvt_row,:) = A(pvt_row,:) / pvt_key;
        
        for i=1:size(A,1)
            if i ~= pvt_row
                A(i,:) = A(i,:) - A(i,pvt_col)*A(pvt_row,:);
            end
        end
        
        % Update
        zjcj = cost(bv)*A - cost;  
        
        zcj = [zjcj; A];
        
        simptable = array2table(zcj);
        simptable.Properties.VariableNames = {'x1','x2','x3','s1','s2','s3','sol'};
        disp(simptable)
        
    else
        run = false;
        fprintf('\nOptimal Solution Reached\n');
    end
end

fprintf('\nFinal Optimal Table:\n');
finalTable = array2table(A);
finalTable.Properties.VariableNames = {'x1','x2','x3','s1','s2','s3','sol'};
disp(finalTable)

solution = zeros(1,n);

for i=1:length(bv)
    if bv(i) <= n
        solution(bv(i)) = A(i,end);
    end
end

fprintf('\nOptimal Solution:\n');
for i=1:n
    fprintf('x%d = %g\n', i, solution(i));
end

fprintf('\nMinimum Value = %g\n', zjcj(end));
