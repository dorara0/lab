clc;
clear all;

M = 1000;

A = [4 3 -1 0 1; 
     1 2  0 1 0];

B = [6 ; 3];

C = [2 1 0 0 M];   

BV = [5 4];   % a1, s2

A = [A B];
C = [C 0];

ZjCj = (C(BV)*A) - C;
zcj = [ZjCj; A];

disp('Initial Table:')
simptable = array2table(zcj);
simptable.Properties.VariableNames = {'x1','x2','s1','s2','a1','sol'};
disp(simptable)

run = true;

while run
    
    zc = ZjCj(1:end-1);
    
    if any(zc > 0)
        
        [~, pvt_col] = max(zc);
        
        sol = A(:,end);
        col = A(:,pvt_col);
        
        ratio = inf(size(A,1),1);
        
        for i=1:size(A,1)
            if col(i) > 0
                ratio(i) = sol(i)/col(i);
            end
        end
        
        [~, pvt_row] = min(ratio);
        
        % Pivot
        pvt_key = A(pvt_row,pvt_col);
        BV(pvt_row) = pvt_col;
        
        A(pvt_row,:) = A(pvt_row,:) / pvt_key;
        
        for i=1:size(A,1)
            if i ~= pvt_row
                A(i,:) = A(i,:) - A(i,pvt_col)*A(pvt_row,:);
            end
        end
        
        % Update
        ZjCj = (C(BV)*A) - C;
        zcj = [ZjCj; A];
        
      
        simptable = array2table(zcj);
        simptable.Properties.VariableNames = {'x1','x2','s1','s2','a1','sol'};
        disp(simptable)
        
    else
        run = false;
        fprintf('\nOptimal Solution Reached\n');
    end
end


fprintf('\nFinal Optimal Table:\n');
finalTable = array2table(A);
finalTable.Properties.VariableNames = {'x1','x2','s1','s2','a1','sol'};
disp(finalTable)

artificial_vars = find(C == M);  
infeasible = false;

for i=1:length(BV)
    if ismember(BV(i), artificial_vars)
        if A(i,end) > 0
            infeasible = true;
        end
    end
end

if infeasible
    fprintf('\nSolution is INFEASIBLE\n');
else
    
  
    n = 2;
    solution = zeros(1,n);
    
    for i=1:length(BV)
        if BV(i) <= n
            solution(BV(i)) = A(i,end);
        end
    end
    
    fprintf('\nOptimal Solution:\n');
    for i=1:n
        fprintf('x%d = %g\n', i, solution(i));
    end
    
    fprintf('\nMinimum Value = %g\n', ZjCj(end));
end
