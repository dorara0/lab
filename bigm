clc;
clear;
M = 1000;
C = [2 1 0 0 -M]; A = [3 1 0 0 1; 4 3 -1 0 0; 1 2 0 1 0]; b = [3; 6; 3];
[m, n] = size(A); Y = [A b]; bv = [5 2 4];
for s = 1:50
    ZjCj = C(bv)*Y(:,1:n) - C;
    Z = C(bv)*Y(:,end);
    fprintf('\nIteration %d\n', s);
    disp(array2table([ZjCj Z; Y],'VariableNames',{'x1','x2','s1','s2','a1','Sol'}))
    if all(ZjCj >= -1e-5)
        break; 
    end
    [~, EV] = min(ZjCj);
    ratios = Y(:,end)./Y(:,EV);
    ratios(Y(:,EV)<=0) = inf;
    [~, LV] = min(ratios);
    bv(LV) = EV;
    Y(LV,:) = Y(LV,:)/Y(LV,EV);
    for i = 1:m
        if i~=LV, Y(i,:) = Y(i,:) - Y(i,EV)*Y(LV,:); end
    end
end
